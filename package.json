{
  "name": "tonecraft",
  "version": "0.1.0",
  "description": "Generate production-grade color primitives from a single brand color, as Figma Variables, Paint Styles, and an in-canvas style guide page.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && npm run build:main",
    "build:ui": "vite build && mv dist/index.html dist/ui.html",
    "build:main": "node esbuild.main.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "culori": "^4.0.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.131.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
