{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@figma/plugin-typings"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src/main", "src/shared", "src/color", "src/exporters"]
}
